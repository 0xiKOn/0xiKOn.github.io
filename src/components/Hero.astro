---
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<section id="hero" class="border-border border-b pt-10 pb-10">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-8">
    {
      /* Replace public/avatar.jpg with your own square photo — no code change needed. */
    }
    <img
      src={getAssetPath("avatar.jpg")}
      alt="Ali Gill"
      width="144"
      height="144"
      loading="eager"
      decoding="async"
      class="border-border size-28 shrink-0 rounded-full border object-cover sm:size-36"
    />

    <div class="min-w-0">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Ali Gill</h1>

      <p class="text-muted-foreground mt-1 text-sm">
        Toronto, Canada · <span class="whitespace-nowrap">@exabsurdo</span>
      </p>

      <p class="mt-4 max-w-2xl leading-relaxed">
        I work on <strong class="font-semibold">security</strong>, and
        increasingly on where it meets <strong class="font-semibold">
          machine learning
        </strong>. I'm at the University of Toronto reading the history and
        philosophy of science and technology alongside mathematics — equally
        interested in both.
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-2">
        <a
          href={getAssetPath("resume.pdf")}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-accent rounded-md px-3 py-1.5 text-sm font-semibold !text-[#11111b] shadow-sm transition hover:opacity-90"
        >
          {t.home.viewResume}
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "about")}
          class="border-border hover:border-accent hover:text-accent rounded-md border px-3 py-1.5 text-sm font-medium transition-colors"
        >
          {t.nav.about}
        </a>
        <a
          href="https://0xikon.gitbook.io/home"
          target="_blank"
          rel="noopener noreferrer"
          class="border-border hover:border-accent hover:text-accent rounded-md border px-3 py-1.5 text-sm font-medium transition-colors"
        >
          Notes
        </a>
      </div>

      {
        socials.length > 0 && (
          <div class="-ms-2 mt-4">
            <span class="sr-only">{t.home.socialLinks}</span>
            <Socials />
          </div>
        )
      }
    </div>
  </div>
</section>
