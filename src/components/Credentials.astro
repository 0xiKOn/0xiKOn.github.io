---
import { getRelativeLocaleUrl } from "astro:i18n";
import { credentials } from "@/data/profile";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<section id="credentials" class="border-border border-b pt-10 pb-8">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h2 class="text-2xl font-semibold tracking-wide">{t.home.credentials}</h2>
    <a
      href={getRelativeLocaleUrl(locale, "about")}
      class="text-muted-foreground hover:text-accent text-sm transition-colors"
    >
      {t.home.credentialsMore} &rarr;
    </a>
  </div>

  <ul class="mt-4 flex flex-wrap gap-2">
    {
      credentials.map(({ abbr, name, year }) => (
        <li
          title={name}
          class="border-border flex items-baseline gap-2 rounded-md border px-2.5 py-1"
        >
          <span class="text-sm font-medium">{abbr}</span>
          <span class="text-muted-foreground text-xs tabular-nums">{year}</span>
        </li>
      ))
    }
  </ul>
</section>
