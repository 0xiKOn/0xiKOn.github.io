---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "./Layout.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  title?: string;
  /** Bare post title, without the " | site" suffix the <title> tag carries. */
  headline?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
};

const { site } = config;

const {
  title,
  headline,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
} = Astro.props;

const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);

const pageURL = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;

// Schema.org wants the article's own headline here — appending the site name
// makes Google treat the title as boilerplate and fall back to the site name.
const articleHeadline = headline ?? title ?? site.title;

const person = {
  "@type": "Person",
  name: site.author,
  ...(site.profile && { url: site.profile }),
};

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  mainEntityOfPage: { "@type": "WebPage", "@id": pageURL },
  url: pageURL,
  headline: articleHeadline,
  name: articleHeadline,
  ...(description && { description }),
  inLanguage: locale,
  image: ogImage,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...((modDatetime ?? pubDatetime) && {
    dateModified: (modDatetime ?? pubDatetime)!.toISOString(),
  }),
  author: [person],
  publisher: person,
};

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: t.nav.home,
      item: new URL(getRelativeLocaleUrl(locale, ""), Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t.nav.posts,
      item: new URL(getRelativeLocaleUrl(locale, "posts"), Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: articleHeadline,
      item: pageURL,
    },
  ],
};
---

<Layout {title} {description} {ogImage} {canonicalURL}>
  <Fragment slot="head">
    <!-- Override og:type for article pages -->
    <meta property="og:type" content="article" />

    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(breadcrumbData)}
    />
  </Fragment>

  <slot />
</Layout>
