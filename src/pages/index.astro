---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Hero from "@/components/Hero.astro";
import Credentials from "@/components/Credentials.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { elsewhere } from "@/data/profile";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts
  .filter(({ data }) => !data.featured)
  .slice(0, postsConfig.perIndex);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <div class="page-backdrop" aria-hidden="true"></div>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <Hero />

    <Credentials />

    {
      (featuredPosts.length > 0 || recentPosts.length > 0) && (
        <section id="writing" class="border-border border-b pt-10 pb-6">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class="text-2xl font-semibold tracking-wide">
              {t.home.writing}
            </h2>
            <a
              href={getRelativeLocaleUrl(locale, "posts")}
              class="text-muted-foreground hover:text-accent text-sm transition-colors"
            >
              {t.home.allPosts} &rarr;
            </a>
          </div>

          {featuredPosts.length > 0 && (
            <>
              <h3 class="text-muted-foreground mt-5 text-xs font-semibold tracking-widest uppercase">
                {t.home.featured}
              </h3>
              <ul>
                {featuredPosts.map(data => (
                  <Card variant="h4" {...data} />
                ))}
              </ul>
            </>
          )}

          {recentPosts.length > 0 && (
            <>
              <h3 class="text-muted-foreground mt-6 text-xs font-semibold tracking-widest uppercase">
                {t.home.recentPosts}
              </h3>
              <ul>
                {recentPosts.map(data => (
                  <Card variant="h4" {...data} />
                ))}
              </ul>
            </>
          )}
        </section>
      )
    }

    {
      elsewhere.length > 0 && (
        <section id="elsewhere" class="pt-10 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.elsewhere}
          </h2>
          <ul class="text-muted-foreground mt-4 flex flex-wrap items-center gap-x-1 gap-y-2">
            {elsewhere.map(({ label, url }, i) => (
              <li class="flex items-center gap-x-1">
                {i > 0 && <span aria-hidden="true">·</span>}
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-foreground hover:text-accent underline decoration-dashed underline-offset-4 transition-colors"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
